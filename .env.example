# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Development only: automatic login account (falls back to the seeded accounts)
NEST_AUTO_LOGIN_EMAIL=student1@nest.edu
NEST_AUTO_LOGIN_PASSWORD=your_seeded_student_password
NEST_AUTO_LOGIN_COORDINATOR_EMAIL=coordinator@nest.edu
NEST_AUTO_LOGIN_COORDINATOR_PASSWORD=your_seeded_coordinator_password

# Google Sheets Integration
GOOGLE_SHEETS_CLIENT_EMAIL=your_service_account_email
GOOGLE_SHEETS_PRIVATE_KEY=your_private_key
GOOGLE_SHEETS_SPREADSHEET_ID=your_spreadsheet_id

# App Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development